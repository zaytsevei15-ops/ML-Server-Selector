{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.mlserverselector_q7m2.runable",
      "versionCode": 4,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#090F1D"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://mlserve-104n4rw-preview-4200.runable.site/",
      "applicationId": "mlserve-104n4rw",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.mlserverselector_q7m2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090F1D"
    },
    "name": "ML Server Selector",
    "slug": "ml-server-selector",
    "version": "1.4.0",
    "scheme": "runable-mlserve-104n4rw",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ],
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/with-openvpn.cjs",
      "./plugins/with-node-ping.cjs"
    ]
  }
}
